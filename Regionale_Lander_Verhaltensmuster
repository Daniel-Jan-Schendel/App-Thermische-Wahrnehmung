    with st.expander("Zusammenfassung: Adaptive Strategien nach Saison"):

        def strategy_label_open(var):
            mapping = {
                "window": "Fenster geöffnet",
                "door": "Tür geöffnet",
                "fan": "Ventilator eingeschaltet",
                "heater": "Heizung eingeschaltet",
                "blind_curtain": "Jalousie/Vorhang geöffnet"
            }
            return mapping.get(var, var)

        def strategy_label_closed(var):
            mapping = {
                "window": "Fenster geschlossen",
                "door": "Tür geschlossen",
                "fan": "Ventilator ausgeschaltet",
                "heater": "Heizung ausgeschaltet",
                "blind_curtain": "Jalousie/Vorhang geschlossen"
            }
            return mapping.get(var, var)


        def explain_strategy(strategy, temp, season):
            """
            Wissenschaftlich einheitliche Erklärung basierend auf ASHRAE‑55,
            adaptiver Komforttheorie und thermophysiologischen Mechanismen.
            """

            # Sommerlogik
            if season == "summer":
                if "Ventilator eingeschaltet" in strategy:
                    return (
                        f"Bei einer operativen Temperatur von {temp:.1f}°C wird verstärkte Luftbewegung "
                        "als adaptive Kühlstrategie eingesetzt. Dies erhöht die konvektive Wärmeabgabe "
                        "und unterstützt die thermische Regulierung gemäß der adaptiven Komforttheorie."
                    )
                if "Fenster geöffnet" in strategy:
                    return (
                        f"Die operative Temperatur von {temp:.1f}°C liegt im moderaten Bereich. "
                        "Natürliche Lüftung wird genutzt, um den Luftwechsel zu erhöhen und "
                        "konvektive Kühlung zu ermöglichen, was typische adaptive Reaktionen im Sommer sind."
                    )
                if "Tür geöffnet" in strategy:
                    return (
                        f"Bei {temp:.1f}°C wird zusätzlicher Luftaustausch durch das Öffnen der Tür "
                        "als passive Kühlmaßnahme eingesetzt. Dies entspricht einer typischen "
                        "sommerlichen Anpassungsstrategie zur Verbesserung der Luftbewegung."
                    )
                if "Jalousie/Vorhang geöffnet" in strategy:
                    return (
                        f"Die operative Temperatur von {temp:.1f}°C ermöglicht eine Nutzung von Tageslicht "
                        "ohne signifikante thermische Belastung. Offene Verschattungselemente unterstützen "
                        "visuellen Komfort bei stabilen sommerlichen Bedingungen."
                    )
                if "Heizung eingeschaltet" in strategy:
                    return (
                        f"Die Nutzung der Heizung bei {temp:.1f}°C ist atypisch für den Sommer und deutet "
                        "auf lokal kühle Innenräume oder individuelle thermische Präferenzen hin."
                    )

            # Winterlogik
            if season == "winter":
                if "Fenster geschlossen" in strategy:
                    return (
                        f"Bei einer operativen Temperatur von {temp:.1f}°C wird das Schließen der Fenster "
                        "als Maßnahme zur Reduktion von Wärmeverlusten eingesetzt. Dies minimiert "
                        "Konvektion und unterstützt die Aufrechterhaltung des thermischen Gleichgewichts."
                    )
                if "Tür geschlossen" in strategy:
                    return (
                        f"Die niedrige operative Temperatur von {temp:.1f}°C führt zu einem erhöhten Bedarf "
                        "an Wärmeerhaltung. Geschlossene Türen reduzieren Infiltration kalter Außenluft "
                        "und stabilisieren das Innenraumklima."
                    )
                if "Ventilator ausgeschaltet" in strategy:
                    return (
                        f"Bei {temp:.1f}°C besteht kein Bedarf an zusätzlicher Luftbewegung. "
                        "Das Abschalten des Ventilators verhindert unerwünschte konvektive Abkühlung "
                        "und entspricht typischen winterlichen Komfortstrategien."
                    )
                if "Heizung eingeschaltet" in strategy:
                    return (
                        f"Die operative Temperatur von {temp:.1f}°C liegt unterhalb der thermischen "
                        "Neutralzone. Die Heizung wird eingesetzt, um Wärmeverluste auszugleichen "
                        "und die thermische Behaglichkeit gemäß ASHRAE‑55 sicherzustellen."
                    )
                if "Jalousie/Vorhang geschlossen" in strategy:
                    return (
                        f"Bei {temp:.1f}°C werden Verschattungselemente geschlossen, um Wärmeverluste "
                        "über Fensterflächen zu reduzieren und Strahlungskälte zu minimieren. "
                        "Dies ist eine typische winterliche Anpassungsstrategie."
                    )

            # Standardfall
            return (
                f"Das Verhalten entspricht einer typischen adaptiven Reaktion auf die operative "
                f"Temperatur von {temp:.1f}°C gemäß der adaptiven Komforttheorie."
            )


