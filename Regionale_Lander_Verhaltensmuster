                "Meist geöffnet/eingeschaltet": f"{top_open_label} ({top_open_value:.1f}%)",
                "Weitere geöffnet/eingeschaltet": "; ".join(other_open) if other_open else "Keine weiteren",
                "Begründung": explanation
            })

   
      

        # Ausgabe Sommer
        st.subheader("Winter")

        df_winter = pd.DataFrame(winter_rows)

        # Sortierung nach operativer Temperatur
        df_winter = df_winter.sort_values("Ø operative Temperatur (°C)", ascending=True)

        st.table(df_winter)


